# HireFlow 环境变量配置模板
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# .env 文件包含敏感信息 (API Key), 已被 .gitignore 排除, 不会提交到 Git

# ============================================================
# LLM 配置
# ============================================================
# 模式: local = LM Studio 本地模型, cloud = DeepSeek API
LLM_MODE=local

# 本地 LM Studio 配置 (LLM_MODE=local 时使用)
LLM_LOCAL_BASE_URL=http://localhost:1234/v1
LLM_LOCAL_API_KEY=lm-studio
LLM_LOCAL_MODEL=qwen3-8b-mlx

# 云端 DeepSeek 配置 (LLM_MODE=cloud 时使用)
LLM_CLOUD_BASE_URL=https://api.deepseek.com
LLM_CLOUD_API_KEY=your-deepseek-api-key-here
LLM_CLOUD_MODEL=deepseek-chat

# ============================================================
# Embedding 配置
# ============================================================
EMBEDDING_MODE=local

# 本地配置
EMBEDDING_LOCAL_BASE_URL=http://localhost:1234/v1
EMBEDDING_LOCAL_API_KEY=lm-studio
EMBEDDING_LOCAL_MODEL=text-embedding-qwen3-embedding-4b

# 云端配置
EMBEDDING_CLOUD_BASE_URL=https://api.deepseek.com
EMBEDDING_CLOUD_API_KEY=your-deepseek-api-key-here
EMBEDDING_CLOUD_MODEL=deepseek-embedding

# ============================================================
# 数据库配置
# ============================================================
DB_URL=postgresql://hireflow:hireflow@localhost:5432/hireflow

# ============================================================
# Qdrant 向量数据库
# ============================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================
# 文档处理
# ============================================================
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50

# ============================================================
# 日志
# ============================================================
LOG_LEVEL=INFO
