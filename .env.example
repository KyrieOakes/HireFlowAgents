# HireFlow 环境变量配置模板
# 复制为 .env 使用: cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 Git

# ============================================================
# LLM 配置
# ============================================================
# 模式: local = LM Studio, cloud = DeepSeek API
LLM_MODE=local

# 本地 (LM Studio)
LLM_LOCAL_BASE_URL=http://localhost:1234/v1
LLM_LOCAL_API_KEY=lm-studio
LLM_LOCAL_MODEL=hermes-3-llama-3.1-8b

# 云端 (DeepSeek)
LLM_CLOUD_BASE_URL=https://api.deepseek.com/v1
LLM_CLOUD_API_KEY=your-deepseek-api-key-here
LLM_CLOUD_MODEL=deepseek-v4-pro

LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ============================================================
# Embedding 配置
# ============================================================
EMBEDDING_MODE=local

EMBEDDING_LOCAL_BASE_URL=http://localhost:1234/v1
EMBEDDING_LOCAL_API_KEY=lm-studio
EMBEDDING_LOCAL_MODEL=text-embedding-qwen3-embedding-4b

EMBEDDING_CLOUD_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_CLOUD_API_KEY=your-deepseek-api-key-here
EMBEDDING_CLOUD_MODEL=deepseek-embedding

# ============================================================
# 数据库
# ============================================================
DB_URL=postgresql://hireflow:hireflow@localhost:5432/hireflow

# ============================================================
# Qdrant
# ============================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================
# 文档处理
# ============================================================
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50

# ============================================================
# 日志
# ============================================================
LOG_LEVEL=INFO
